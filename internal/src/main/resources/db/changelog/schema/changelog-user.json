{
    "databaseChangeLog": [
        {
            "changeSet": {
                "id": "create-table-user",
                "author": "Mr.Lee",
                "context": "dev",
                "changes": [
                    {
                        "createTable": {
                            "tableName": "t_user",
                            "remarks": "用户表",
                            "columns": [
                                {
                                    "column": {
                                        "name": "id",
                                        "type": "VARCHAR(50)",
                                        "constraints": {
                                            "nullable": false,
                                            "primaryKey": true,
                                            "primaryKeyName": "t_user_pk"
                                        },
                                        "remarks": "用户ID"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "username",
                                        "type": "VARCHAR(30)",
                                        "constraints": {
                                            "nullable": false
                                        },
                                        "remarks": "用户账号"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "password",
                                        "type": "VARCHAR(255)",
                                        "constraints": {
                                            "nullable": false
                                        },
                                        "remarks": "密码"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "nickname",
                                        "type": "VARCHAR(30)",
                                        "defaultValue": "",
                                        "remarks": "用户昵称"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "email",
                                        "type": "VARCHAR(50)",
                                        "defaultValue": "",
                                        "remarks": "用户邮箱"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "tel",
                                        "type": "VARCHAR(15)",
                                        "defaultValue": "",
                                        "remarks": "手机号码"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "sex",
                                        "type": "SMALLINT",
                                        "defaultValueNumeric": 0,
                                        "remarks": "用户性别(1男 2女 0未知)"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "avatar",
                                        "type": "VARCHAR(255)",
                                        "defaultValue": "",
                                        "remarks": "头像地址"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "status",
                                        "type": "SMALLINT",
                                        "defaultValueNumeric": 0,
                                        "remarks": "帐号状态(0正常 1停用)"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "create_time",
                                        "type": "TIMESTAMP",
                                        "defaultValueComputed": "CURRENT_TIMESTAMP",
                                        "remarks": "创建时间"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "update_time",
                                        "type": "TIMESTAMP",
                                        "defaultValueComputed": "CURRENT_TIMESTAMP",
                                        "remarks": "更新时间"
                                    }
                                },
                                {
                                    "column": {
                                        "name": "deleted",
                                        "type": "SMALLINT",
                                        "defaultValueNumeric": 0,
                                        "remarks": "删除标志(0否 1是)"
                                    }
                                }
                            ]
                        }
                    },
                    {
                        "createIndex": {
                            "indexName": "t_user_username_index",
                            "tableName": "t_user",
                            "columns": [
                                {
                                    "column": {
                                        "name": "username"
                                    }
                                }
                            ],
                            "unique": true
                        }
                    }
                ]
            }
        }
    ]
}